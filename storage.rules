rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminOrModerator() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.moderator == true
        );
    }

    function isValidProfileImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /pictures/{uid}/{fileName=**} {
      allow read: if isOwner(uid) || isAdminOrModerator();
      allow create, update: if isOwner(uid) && isValidProfileImage();
      allow delete: if isOwner(uid) || isAdminOrModerator();
    }

    match /publicPictures/{uid}/{fileName=**} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if false;
      allow delete: if isOwner(uid) || isAdminOrModerator();
    }

    match /verificationSelfies/{uid}/{fileName=**} {
      allow read: if signedIn()
        && (
          request.auth.uid == uid
          || request.auth.token.admin == true
          || request.auth.token.moderator == true
        );
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if signedIn()
        && (
          request.auth.uid == uid
          || request.auth.token.admin == true
          || request.auth.token.moderator == true
        );
    }

    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }
  }
} 
