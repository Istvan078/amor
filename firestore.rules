rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminOrModerator() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.moderator == true
        );
    }

    function userIsNotBanned(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.isBanned != true;
    }

    function matchPartsHas(data, key) {
      return data.keys().hasAny(['matchParts'])
        && data.matchParts is map
        && data.matchParts.keys().hasAny([key]);
    }

    function protectedMatchPartCreateIsEmpty(key) {
      return !matchPartsHas(request.resource.data, key)
        || (
          request.resource.data.matchParts[key] is list
          && request.resource.data.matchParts[key].size() == 0
        );
    }

    function protectedUserCreateFieldsAreSafe() {
      return (
          !request.resource.data.keys().hasAny(['isBanned'])
          || request.resource.data.isBanned == false
        )
        && protectedMatchPartCreateIsEmpty('matches')
        && protectedMatchPartCreateIsEmpty('liked')
        && protectedMatchPartCreateIsEmpty('superLiked')
        && protectedMatchPartCreateIsEmpty('notLiked');
    }

    function protectedMatchPartUnchangedOrEmpty(key) {
      return (
          matchPartsHas(resource.data, key)
          && matchPartsHas(request.resource.data, key)
          && request.resource.data.matchParts[key] == resource.data.matchParts[key]
        )
        || (
          !matchPartsHas(resource.data, key)
          && (
            !matchPartsHas(request.resource.data, key)
            || (
              request.resource.data.matchParts[key] is list
              && request.resource.data.matchParts[key].size() == 0
            )
          )
        );
    }

    function protectedUserUpdateFieldsAreSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBanned'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'matchParts'
          ])
          || (
            request.resource.data.matchParts is map
            && protectedMatchPartUnchangedOrEmpty('matches')
            && protectedMatchPartUnchangedOrEmpty('liked')
            && protectedMatchPartUnchangedOrEmpty('superLiked')
            && protectedMatchPartUnchangedOrEmpty('notLiked')
          )
        );
    }

    function protectedMatchIndexCreateFieldsAreSafe() {
      return !request.resource.data.keys().hasAny(['boostedUntil'])
        && (
          !request.resource.data.keys().hasAny(['isBanned'])
          || request.resource.data.isBanned == false
        );
    }

    function protectedMatchIndexUpdateFieldsAreSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'boostedUntil',
        'isBanned'
      ]);
    }

    function isConversationParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function isConversationParticipantOnCreate() {
      return signedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2;
    }

    function validReportReason(reason) {
      return reason in [
        'fakeProfile',
        'harassment',
        'spam',
        'inappropriateContent',
        'other',
        'conversation_report'
      ];
    }

    function validReportStatus(status) {
      return status in [
        'open',
        'reviewed',
        'dismissed',
        'action_taken'
      ];
    }

    function validReportCreate(reportId) {
      return request.resource.data.keys().hasOnly([
          'reportId',
          'reporterUid',
          'reportedUid',
          'reason',
          'description',
          'source',
          'conversationId',
          'messageId',
          'messageText',
          'messageSentAt',
          'messageSenderUid',
          'createdAt',
          'status'
        ])
        && request.resource.data.keys().hasAll([
          'reportId',
          'reporterUid',
          'reportedUid',
          'reason',
          'description',
          'createdAt',
          'status'
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid is string
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.description is string
        && (
          !request.resource.data.keys().hasAny(['source'])
          || request.resource.data.source in ['profile', 'conversation', 'message']
        )
        && (
          !request.resource.data.keys().hasAny(['conversationId'])
          || request.resource.data.conversationId is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageId'])
          || request.resource.data.messageId is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageText'])
          || request.resource.data.messageText is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageSentAt'])
          || request.resource.data.messageSentAt is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageSenderUid'])
          || (
            request.resource.data.messageSenderUid is string
            && request.resource.data.messageSenderUid == request.resource.data.reportedUid
          )
        )
        && validReportReason(request.resource.data.reason)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isAdminOrModerator()
        || (isOwner(uid) && protectedUserCreateFieldsAreSafe());
      allow update: if isAdminOrModerator()
        || (isOwner(uid) && protectedUserUpdateFieldsAreSafe());
      allow delete: if isOwner(uid) || isAdminOrModerator();

      match /billing/{billingDocument} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow write: if isAdminOrModerator();
      }

      match /usage/{date} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /analytics/{eventId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'eventName',
            'properties',
            'clientCreatedAt',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'eventName',
            'properties',
            'clientCreatedAt',
            'createdAt'
          ])
          && request.resource.data.eventName is string
          && request.resource.data.properties is map
          && request.resource.data.clientCreatedAt is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isAdminOrModerator()
          || (
            signedIn()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly([
            'type',
            'actorUid',
            'conversationId',
            'title',
            'body',
            'isRead',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'type',
            'actorUid',
            'title',
            'body',
            'isRead',
            'createdAt'
          ])
          && request.resource.data.type in ['new_message', 'new_match']
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt is timestamp
          );
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow delete: if isOwner(uid) || isAdminOrModerator();
      }

      match /warnings/{warningId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isAdminOrModerator();
        allow update, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.platform is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(uid) || isAdminOrModerator();
      }
    }

    match /matchIndex/{uid} {
      allow read: if isOwner(uid) || isAdminOrModerator();
      allow create: if isAdminOrModerator()
        || (
          isOwner(uid)
          && userIsNotBanned(uid)
          && protectedMatchIndexCreateFieldsAreSafe()
        );
      allow update: if isAdminOrModerator()
        || (
          isOwner(uid)
          && userIsNotBanned(uid)
          && protectedMatchIndexUpdateFieldsAreSafe()
        );
      allow delete: if isAdminOrModerator()
        || (isOwner(uid) && userIsNotBanned(uid));
    }

    match /reports/{reportId} {
      allow create: if signedIn() && validReportCreate(reportId);
      allow read, delete: if isAdminOrModerator();
      allow update: if isAdminOrModerator()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'statusHistory',
          'updatedAt'
        ])
        && validReportStatus(request.resource.data.status);
    }

    match /moderationAudit/{auditId} {
      allow read, create: if isAdminOrModerator();
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isConversationParticipantOnCreate();
      allow read: if isConversationParticipant() || isAdminOrModerator();
      allow update: if isConversationParticipant();
      allow delete: if isAdminOrModerator();

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        function isMessageParticipant() {
          return signedIn() && request.auth.uid in conversation().data.participants;
        }

        allow read: if isMessageParticipant() || isAdminOrModerator();
        allow create: if isMessageParticipant()
          && request.resource.data.senderUid == request.auth.uid;
        allow update: if isMessageParticipant()
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            'reactions',
            'isRead',
            'readAt'
          ]);
        allow delete: if isAdminOrModerator();
      }
    }

    match /matches/{legacyDocument=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
