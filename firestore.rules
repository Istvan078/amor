rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdminOrModerator() {
      return signedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.moderator == true
        );
    }

    function userIsNotBanned(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid))
        || get(/databases/$(database)/documents/users/$(uid)).data.isBanned != true;
    }

    function matchPartsHas(data, key) {
      return data.keys().hasAny(['matchParts'])
        && data.matchParts is map
        && data.matchParts.keys().hasAny([key]);
    }

    function protectedMatchPartCreateIsEmpty(key) {
      return !matchPartsHas(request.resource.data, key)
        || (
          request.resource.data.matchParts[key] is list
          && request.resource.data.matchParts[key].size() == 0
        );
    }

    function lookingForAgeIsSafe(data) {
      return !data.keys().hasAny(['lookingForAge'])
        || (
          data.lookingForAge is map
          && data.lookingForAge.keys().hasAny(['lower'])
          && data.lookingForAge.lower is number
          && data.lookingForAge.lower >= 18
          && (
            !data.lookingForAge.keys().hasAny(['upper'])
            || (
              data.lookingForAge.upper is number
              && data.lookingForAge.upper >= data.lookingForAge.lower
            )
          )
        );
    }

    function lookingForAgeUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'lookingForAge'
        ])
        || lookingForAgeIsSafe(request.resource.data);
    }

    function adultBirthDateCutoff() {
      return timestamp.value(request.time.toMillis() - 568036800000);
    }

    function birthDateIsAdult(data) {
      return data.keys().hasAny(['birthDateTimestamp'])
        && data.birthDateTimestamp is timestamp
        && data.birthDateTimestamp <= adultBirthDateCutoff();
    }

    function ageIsAdult(data) {
      return data.keys().hasAny(['age'])
        && data.age is number
        && data.age >= 18;
    }

    function adultProfileDataIsSafe(data) {
      return birthDateIsAdult(data) && ageIsAdult(data);
    }

    function currentPrivacyConsentVersion() {
      return '1.1.0';
    }

    function privacyConsentIsSafe(consent) {
      return consent is map
        && consent.keys().hasOnly([
          'essential',
          'termsAccepted',
          'privacyPolicyAccepted',
          'communityGuidelinesAccepted',
          'ageConfirmed',
          'crashReports',
          'analytics',
          'personalisation',
          'marketingNotifications',
          'consentVersion',
          'updatedAt'
        ])
        && consent.keys().hasAll([
          'essential',
          'termsAccepted',
          'privacyPolicyAccepted',
          'communityGuidelinesAccepted',
          'ageConfirmed',
          'crashReports',
          'analytics',
          'personalisation',
          'marketingNotifications',
          'consentVersion',
          'updatedAt'
        ])
        && consent.essential == true
        && consent.termsAccepted == true
        && consent.privacyPolicyAccepted == true
        && consent.communityGuidelinesAccepted == true
        && consent.ageConfirmed == true
        && consent.crashReports is bool
        && consent.analytics is bool
        && consent.personalisation is bool
        && consent.marketingNotifications is bool
        && consent.consentVersion == currentPrivacyConsentVersion()
        && consent.updatedAt is string;
    }

    function profileHasRequiredPrivacyConsent(data) {
      return data.keys().hasAny(['privacyConsent'])
        && privacyConsentIsSafe(data.privacyConsent);
    }

    function privacyConsentUpdateIsSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'privacyConsent'
        ])
        || profileHasRequiredPrivacyConsent(request.resource.data);
    }

    function consentOnlyUserCreateIsSafe() {
      return request.resource.data.keys().hasOnly(['privacyConsent'])
        && profileHasRequiredPrivacyConsent(request.resource.data);
    }

    function protectedUserCreateFieldsAreSafe() {
      return (
          !request.resource.data.keys().hasAny(['isBanned'])
          || request.resource.data.isBanned == false
        )
        && !request.resource.data.keys().hasAny([
          'profileVerified',
          'profileVerificationStatus',
          'profileVerifiedAt',
          'profileVerifiedBy',
          'profileVerificationRequestedAt',
          'profileVerificationReviewedAt',
          'profileVerificationReviewedBy',
          'profileVerificationReviewNote',
          'profileQualityScore',
          'moderationRiskScore',
          'moderationRiskReasons',
          'lastRiskFlaggedAt'
        ])
        && protectedMatchPartCreateIsEmpty('matches')
        && protectedMatchPartCreateIsEmpty('liked')
        && protectedMatchPartCreateIsEmpty('superLiked')
        && protectedMatchPartCreateIsEmpty('notLiked')
        && lookingForAgeIsSafe(request.resource.data)
        && adultProfileDataIsSafe(request.resource.data)
        && profileHasRequiredPrivacyConsent(request.resource.data);
    }

    function protectedMatchPartUnchangedOrEmpty(key) {
      return (
          matchPartsHas(resource.data, key)
          && matchPartsHas(request.resource.data, key)
          && request.resource.data.matchParts[key] == resource.data.matchParts[key]
        )
        || (
          !matchPartsHas(resource.data, key)
          && (
            !matchPartsHas(request.resource.data, key)
            || (
              request.resource.data.matchParts[key] is list
              && request.resource.data.matchParts[key].size() == 0
            )
          )
        );
    }

    function protectedUserUpdateFieldsAreSafe() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'isBanned',
          'profileVerified',
          'profileVerificationStatus',
          'profileVerifiedAt',
          'profileVerifiedBy',
          'profileVerificationRequestedAt',
          'profileVerificationReviewedAt',
          'profileVerificationReviewedBy',
          'profileVerificationReviewNote',
          'profileQualityScore',
          'moderationRiskScore',
          'moderationRiskReasons',
          'lastRiskFlaggedAt'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'matchParts'
          ])
          || (
            request.resource.data.matchParts is map
            && protectedMatchPartUnchangedOrEmpty('matches')
            && protectedMatchPartUnchangedOrEmpty('liked')
            && protectedMatchPartUnchangedOrEmpty('superLiked')
            && protectedMatchPartUnchangedOrEmpty('notLiked')
          )
        )
        && lookingForAgeUpdateIsSafe()
        && privacyConsentUpdateIsSafe()
        && adultProfileDataIsSafe(request.resource.data)
        && profileHasRequiredPrivacyConsent(request.resource.data);
    }

    function protectedMatchIndexCreateFieldsAreSafe() {
      return !request.resource.data.keys().hasAny(['boostedUntil'])
        && !request.resource.data.keys().hasAny([
          'profileVerified',
          'profileVerificationStatus',
          'profileQualityScore',
          'moderationRiskScore',
          'moderationRiskReasons',
          'lastRiskFlaggedAt'
        ])
        && (
          !request.resource.data.keys().hasAny(['isBanned'])
          || request.resource.data.isBanned == false
        )
        && (
          !request.resource.data.keys().hasAny(['age'])
          || (
            request.resource.data.age is number
            && request.resource.data.age >= 18
          )
        );
    }

    function protectedMatchIndexUpdateFieldsAreSafe() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();

      return !affectedKeys.hasAny(['boostedUntil'])
        && !affectedKeys.hasAny([
          'profileVerified',
          'profileVerificationStatus',
          'profileQualityScore',
          'moderationRiskScore',
          'moderationRiskReasons',
          'lastRiskFlaggedAt'
        ])
        && (
          !affectedKeys.hasAny(['isBanned'])
          || (
            (
              !resource.data.keys().hasAny(['isBanned'])
              || resource.data.isBanned == false
            )
            && request.resource.data.isBanned == false
          )
        )
        && (
          !affectedKeys.hasAny(['age'])
          || (
            request.resource.data.age is number
            && request.resource.data.age >= 18
          )
        );
    }

    function isConversationParticipant() {
      return signedIn() && request.auth.uid in resource.data.participants;
    }

    function hasTwoParticipants(data) {
      return data.keys().hasAny(['participants'])
        && data.participants is list
        && data.participants.size() == 2
        && data.participants[0] is string
        && data.participants[1] is string
        && data.participants[0] != data.participants[1];
    }

    function otherConversationParticipant(data) {
      return data.participants[0] == request.auth.uid
        ? data.participants[1]
        : data.participants[0];
    }

    function conversationParticipantsAreMatched(data) {
      let otherUid = otherConversationParticipant(data);

      return hasTwoParticipants(data)
        && request.auth.uid in data.participants
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(otherUid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matchParts.matches is list
        && get(/databases/$(database)/documents/users/$(otherUid)).data.matchParts.matches is list
        && otherUid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.matchParts.matches
        && request.auth.uid in get(/databases/$(database)/documents/users/$(otherUid)).data.matchParts.matches;
    }

    function requesterHasRequiredPrivacyConsent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileHasRequiredPrivacyConsent(
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        );
    }

    function isConversationParticipantOnCreate() {
      return signedIn()
        && hasTwoParticipants(request.resource.data)
        && request.auth.uid in request.resource.data.participants
        && requesterHasRequiredPrivacyConsent()
        && conversationParticipantsAreMatched(request.resource.data);
    }

    function isMissingConversationRead(conversationId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/conversations/$(conversationId));
    }

    function validConversationCreate() {
      return request.resource.data.keys().hasOnly([
          'participants',
          'typing',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll(['participants'])
        && (
          !request.resource.data.keys().hasAny(['typing'])
          || validTypingMap(request.resource.data)
        )
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt is timestamp
        );
    }

    function currentTypingMap() {
      return resource.data.keys().hasAny(['typing']) && resource.data.typing is map
        ? resource.data.typing
        : {};
    }

    function validTypingValue(data, uid) {
      return !data.typing.keys().hasAny([uid])
        || data.typing[uid] == null
        || data.typing[uid] is timestamp;
    }

    function validTypingMap(data) {
      return data.typing is map
        && data.typing.keys().hasOnly(data.participants)
        && validTypingValue(data, data.participants[0])
        && validTypingValue(data, data.participants[1]);
    }

    function validConversationTypingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typing'])
        && request.resource.data.participants == resource.data.participants
        && validTypingMap(request.resource.data)
        && request.resource.data.typing.diff(currentTypingMap()).affectedKeys().hasOnly([
          request.auth.uid
        ]);
    }

    function validConversationUnreadReset() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unreadCounts'
        ])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.unreadCounts is map
        && request.resource.data.unreadCounts.diff(resource.data.unreadCounts).affectedKeys().hasOnly([
          request.auth.uid
        ])
        && request.resource.data.unreadCounts[request.auth.uid] == 0;
    }

    function validConversationUpdate() {
      return validConversationTypingUpdate()
        || validConversationUnreadReset();
    }

    function validReportReason(reason) {
      return reason in [
        'fakeProfile',
        'harassment',
        'spam',
        'inappropriateContent',
        'other',
        'conversation_report'
      ];
    }

    function validReportStatus(status) {
      return status in [
        'open',
        'reviewed',
        'dismissed',
        'action_taken'
      ];
    }

    function validReportCreate(reportId) {
      return request.resource.data.keys().hasOnly([
          'reportId',
          'reporterUid',
          'reportedUid',
          'reason',
          'description',
          'source',
          'conversationId',
          'messageId',
          'messageText',
          'messageSentAt',
          'messageSenderUid',
          'createdAt',
          'status'
        ])
        && request.resource.data.keys().hasAll([
          'reportId',
          'reporterUid',
          'reportedUid',
          'reason',
          'description',
          'createdAt',
          'status'
        ])
        && request.resource.data.reportId == reportId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterUid is string
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.description is string
        && (
          !request.resource.data.keys().hasAny(['source'])
          || request.resource.data.source in ['profile', 'conversation', 'message']
        )
        && (
          !request.resource.data.keys().hasAny(['conversationId'])
          || request.resource.data.conversationId is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageId'])
          || request.resource.data.messageId is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageText'])
          || request.resource.data.messageText is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageSentAt'])
          || request.resource.data.messageSentAt is string
        )
        && (
          !request.resource.data.keys().hasAny(['messageSenderUid'])
          || (
            request.resource.data.messageSenderUid is string
            && request.resource.data.messageSenderUid == request.resource.data.reportedUid
          )
        )
        && validReportReason(request.resource.data.reason)
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdminOrModerator();
      allow create: if isAdminOrModerator()
        || (
          isOwner(uid)
          && (
            consentOnlyUserCreateIsSafe()
            || protectedUserCreateFieldsAreSafe()
          )
        );
      allow update: if isAdminOrModerator()
        || (isOwner(uid) && protectedUserUpdateFieldsAreSafe());
      allow delete: if isOwner(uid) || isAdminOrModerator();

      match /billing/{billingDocument} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow write: if isAdminOrModerator();
      }

      match /usage/{date} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create, update: if false;
        allow delete: if false;
      }

      match /analytics/{eventId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'eventName',
            'properties',
            'clientCreatedAt',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'eventName',
            'properties',
            'clientCreatedAt',
            'createdAt'
          ])
          && request.resource.data.eventName is string
          && request.resource.data.properties is map
          && request.resource.data.clientCreatedAt is string
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isAdminOrModerator()
          || (
            signedIn()
          && request.auth.uid != uid
          && request.resource.data.keys().hasOnly([
            'type',
            'actorUid',
            'conversationId',
            'title',
            'body',
            'isRead',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'type',
            'actorUid',
            'title',
            'body',
            'isRead',
            'createdAt'
          ])
          && request.resource.data.type in ['new_message', 'new_match']
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.body is string
          && request.resource.data.isRead == false
          && request.resource.data.createdAt is timestamp
          );
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['isRead'])
          && request.resource.data.isRead is bool;
        allow delete: if isOwner(uid) || isAdminOrModerator();
      }

      match /warnings/{warningId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create: if isAdminOrModerator();
        allow update, delete: if false;
      }

      match /pushTokens/{tokenId} {
        allow read: if isOwner(uid) || isAdminOrModerator();
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.platform is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(uid) || isAdminOrModerator();
      }
    }

    match /publicProfiles/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow update: if isOwner(uid)
        && resource.data.showOnlineStatus == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isOnline',
          'lastSeenAt',
          'lastActiveAt'
        ])
        && request.resource.data.isOnline is bool
        && request.resource.data.lastSeenAt is string
        && request.resource.data.lastActiveAt is string;
      allow create, delete: if false;
    }

    match /matchIndex/{uid} {
      allow read: if isOwner(uid) || isAdminOrModerator();
      allow create: if isAdminOrModerator()
        || (
          isOwner(uid)
          && userIsNotBanned(uid)
          && protectedMatchIndexCreateFieldsAreSafe()
        );
      allow update: if isAdminOrModerator()
        || (
          isOwner(uid)
          && userIsNotBanned(uid)
          && protectedMatchIndexUpdateFieldsAreSafe()
        );
      allow delete: if isAdminOrModerator()
        || (isOwner(uid) && userIsNotBanned(uid));
    }

    match /incomingLikes/{targetUid}/likes/{actorUid} {
      allow read: if isOwner(targetUid) || isAdminOrModerator();
      allow update: if isOwner(targetUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'seen',
          'seenAt'
        ])
        && request.resource.data.seen is bool
        && (
          !request.resource.data.keys().hasAny(['seenAt'])
          || request.resource.data.seenAt is timestamp
        );
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && validReportCreate(reportId);
      allow read, delete: if isAdminOrModerator();
      allow update: if isAdminOrModerator()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'statusHistory',
          'updatedAt'
        ])
        && validReportStatus(request.resource.data.status);
    }

    match /moderationAudit/{auditId} {
      allow read, create: if isAdminOrModerator();
      allow update, delete: if false;
    }

    match /profileVerifications/{uid} {
      allow read: if isOwner(uid) || isAdminOrModerator();
      allow write: if isAdminOrModerator();
    }

    match /imageModeration/{moderationId} {
      allow read: if isAdminOrModerator()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /profileRiskFlags/{uid} {
      allow read, update: if isAdminOrModerator();
      allow create, delete: if false;
    }

    match /trustSignals/{uid} {
      allow read: if isAdminOrModerator();
      allow write: if false;
    }

    match /conversations/{conversationId} {
      allow create: if isConversationParticipantOnCreate()
        && validConversationCreate();
      allow read: if isConversationParticipant()
        || isAdminOrModerator()
        || isMissingConversationRead(conversationId);
      allow update: if isConversationParticipant()
        && validConversationUpdate();
      allow delete: if isAdminOrModerator();

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId));
        }

        function isMessageParticipant() {
          return signedIn() && request.auth.uid in conversation().data.participants;
        }

        function messageOtherParticipant() {
          return conversation().data.participants[0] == request.auth.uid
            ? conversation().data.participants[1]
            : conversation().data.participants[0];
        }

        function messageParticipantsAreMatched() {
          return conversationParticipantsAreMatched(conversation().data);
        }

        function validMessageText(data) {
          return data.text is string
            && data.text.size() <= 2000
            && (
              data.type == 'gif'
              || data.text.size() > 0
            );
        }

        function validNoAttachments(data) {
          return !data.keys().hasAny(['attachments'])
            || (
              data.attachments is list
              && data.attachments.size() == 0
            );
        }

        function validGif(data) {
          return (
              data.type == 'text'
              && (
                !data.keys().hasAny(['gif'])
                || data.gif == null
              )
            )
            || (
              data.type == 'gif'
              && data.gif is map
              && data.gif.keys().hasOnly([
                'id',
                'title',
                'url',
                'previewUrl',
                'alt',
                'source'
              ])
              && data.gif.keys().hasAll(['id', 'title', 'url', 'source'])
              && data.gif.id in ['amor-heartbeat', 'amor-spark', 'amor-cheers']
              && data.gif.title is string
              && data.gif.title.size() <= 80
              && data.gif.url in [
                'assets/gifs/amor-heartbeat.svg',
                'assets/gifs/amor-spark.svg',
                'assets/gifs/amor-cheers.svg'
              ]
              && (
                !data.gif.keys().hasAny(['previewUrl'])
                || data.gif.previewUrl in [
                  'assets/gifs/amor-heartbeat.svg',
                  'assets/gifs/amor-spark.svg',
                  'assets/gifs/amor-cheers.svg'
                ]
              )
              && (
                !data.gif.keys().hasAny(['alt'])
                || (
                  data.gif.alt is string
                  && data.gif.alt.size() <= 120
                )
              )
              && data.gif.source == 'local'
            );
        }

        function validReactionValue(data, uid) {
          return !data.reactions.keys().hasAny([uid])
            || data.reactions[uid] == null
            || (
              data.reactions[uid] is map
              && data.reactions[uid].keys().hasOnly(['emoji', 'updatedAt'])
              && data.reactions[uid].keys().hasAll(['emoji', 'updatedAt'])
              && data.reactions[uid].emoji is string
              && data.reactions[uid].emoji.size() <= 16
              && data.reactions[uid].updatedAt is timestamp
            );
        }

        function validReactionMap(data) {
          return !data.keys().hasAny(['reactions'])
            || (
              data.reactions is map
              && data.reactions.keys().hasOnly(conversation().data.participants)
              && validReactionValue(data, conversation().data.participants[0])
              && validReactionValue(data, conversation().data.participants[1])
            );
        }

        function currentReactionMap() {
          return resource.data.keys().hasAny(['reactions']) && resource.data.reactions is map
            ? resource.data.reactions
            : {};
        }

        function emptyReactionMap(data) {
          return data.reactions is map
            && data.reactions.keys().size() == 0;
        }

        function validMessageCreate() {
          return request.resource.data.keys().hasOnly([
              'senderUid',
              'sentToUid',
              'text',
              'type',
              'number',
              'sentAt',
              'readAt',
              'isRead',
              'attachments',
              'gif',
              'reactions',
              'isDeleted',
              'isStarred',
              'isEdited',
              'editedAt',
              'deletedAt'
            ])
            && request.resource.data.keys().hasAll([
              'senderUid',
              'sentToUid',
              'text',
              'type',
              'number',
              'sentAt',
              'isRead'
            ])
            && request.resource.data.senderUid == request.auth.uid
            && request.resource.data.sentToUid == messageOtherParticipant()
            && request.resource.data.type in ['text', 'gif']
            && validMessageText(request.resource.data)
            && validNoAttachments(request.resource.data)
            && validGif(request.resource.data)
            && validReactionMap(request.resource.data)
            && request.resource.data.number is number
            && request.resource.data.number >= 0
            && request.resource.data.sentAt is timestamp
            && request.resource.data.isRead == false
            && (
              !request.resource.data.keys().hasAny(['readAt'])
              || request.resource.data.readAt == null
              || request.resource.data.readAt is timestamp
            )
            && (
              !request.resource.data.keys().hasAny(['isDeleted'])
              || request.resource.data.isDeleted == false
            )
            && (
              !request.resource.data.keys().hasAny(['isStarred'])
              || request.resource.data.isStarred == false
            )
            && (
              !request.resource.data.keys().hasAny(['isEdited'])
              || request.resource.data.isEdited == false
            )
            && (
              !request.resource.data.keys().hasAny(['editedAt'])
              || request.resource.data.editedAt == null
              || request.resource.data.editedAt is timestamp
            )
            && (
              !request.resource.data.keys().hasAny(['deletedAt'])
              || request.resource.data.deletedAt == null
              || request.resource.data.deletedAt is timestamp
            );
        }

        function messageIdentityIsImmutable() {
          return request.resource.data.senderUid == resource.data.senderUid
            && request.resource.data.sentToUid == resource.data.sentToUid
            && request.resource.data.number == resource.data.number
            && request.resource.data.sentAt == resource.data.sentAt;
        }

        function validMessageReadUpdate() {
          return resource.data.sentToUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isRead',
              'readAt'
            ])
            && messageIdentityIsImmutable()
            && request.resource.data.isRead == true
            && request.resource.data.readAt is timestamp;
        }

        function validMessageEditUpdate() {
          return resource.data.senderUid == request.auth.uid
            && resource.data.isDeleted != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'type',
              'gif',
              'attachments',
              'isEdited',
              'editedAt'
            ])
            && messageIdentityIsImmutable()
            && request.resource.data.type == 'text'
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 2000
            && request.resource.data.gif == null
            && validNoAttachments(request.resource.data)
            && request.resource.data.isEdited == true
            && request.resource.data.editedAt is timestamp;
        }

        function validMessageDeleteUpdate() {
          return resource.data.senderUid == request.auth.uid
            && resource.data.isDeleted != true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'type',
              'gif',
              'attachments',
              'reactions',
              'isDeleted',
              'isEdited',
              'deletedAt'
            ])
            && messageIdentityIsImmutable()
            && request.resource.data.text == ''
            && request.resource.data.type == 'text'
            && request.resource.data.gif == null
            && request.resource.data.attachments is list
            && request.resource.data.attachments.size() == 0
            && emptyReactionMap(request.resource.data)
            && request.resource.data.isDeleted == true
            && request.resource.data.isEdited == false
            && request.resource.data.deletedAt is timestamp;
        }

        function validMessageReactionUpdate() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reactions'
            ])
            && messageIdentityIsImmutable()
            && validReactionMap(request.resource.data)
            && request.resource.data.reactions.diff(currentReactionMap()).affectedKeys().hasOnly([
              request.auth.uid
            ]);
        }

        allow read: if isMessageParticipant() || isAdminOrModerator();
        allow create: if false;
        allow update: if isMessageParticipant()
          && (
            validMessageReactionUpdate()
            || validMessageReadUpdate()
            || validMessageEditUpdate()
            || validMessageDeleteUpdate()
          );
        allow delete: if isAdminOrModerator();
      }
    }

    match /matches/{legacyDocument=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
